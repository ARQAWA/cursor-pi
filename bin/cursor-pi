#!/usr/bin/env bash
# Starts stock Pi with its own prompt, tools and extensions turned off, and loads the Cursor Pi extension.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.cursor-pi/agent}"
mkdir -p "$PI_CODING_AGENT_DIR"
if [ ! -e "$PI_CODING_AGENT_DIR/settings.json" ]; then
  printf '%s\n' '{"compaction":{"enabled":false}}' > "$PI_CODING_AGENT_DIR/settings.json"
fi

exec pi --no-builtin-tools --no-extensions --no-skills --no-prompt-templates --no-context-files --no-mcp -e "$ROOT/extensions/cursor-pi/index.ts" "$@"
